#!/bin/sh
# Versioned hook. Lives in .githooks/ rather than .git/hooks/ so it is
# reviewable in the diff and travels with a clone; a clone activates it once:
#
#     git config core.hooksPath .githooks
#
# Bypassing this with --no-verify is not a fix. If it fires, the path is real.
set -e

# Pick the interpreter by running it, not by finding it on PATH.
#
# python3 first, not `python`: on a machine where `python` is still a Python 2
# - older macOS, a conda env, a stale alias - the checker dies with a traceback
# about subprocess.run's capture_output (3.7+) instead of saying anything about
# paths. It fails closed, so nothing leaks, but the natural response to a hook
# that breaks for no visible reason is `--no-verify`, and the note above is
# right that that is not a fix.
#
# But `command -v python3` is not enough either: on Windows, python3 is often
# the Microsoft Store alias, which exists on PATH and exits non-zero without
# running anything. So each candidate must actually run and report 3.7+; the
# first that does is used. `py -3` is the Windows launcher. $cand is left
# unquoted on purpose so "py -3" splits into a command and its argument.
PY=
for cand in python3 python "py -3"; do
  if $cand -c 'import sys; sys.exit(0 if sys.version_info >= (3, 7) else 1)' >/dev/null 2>&1; then
    PY=$cand
    break
  fi
done

# Say so if nothing can run the checker, rather than letting it fail with
# something that reads like a bug in the hook.
if [ -z "$PY" ]; then
  echo "pre-commit: no working Python 3.7+ found (tried python3, python, py -3); tools/check_no_local_paths.py needs one." >&2
  exit 1
fi

exec $PY tools/check_no_local_paths.py --staged
